{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fieldnote:project:2",
  "title": "Fieldnote project file, schemaVersion 2 (approved by Claude and Codex, pending hash freeze)",
  "$comment": "Every v1 validator rule still applies unless amended here. Amended or added rules, enforced by the app validator before any state is replaced: (1) raw file <= 26214400 bytes, checked before parsing, unchanged; (2)-(5) per-image decode, byte, sha256, signature and dimension rules unchanged; (6) image ids are unique. Every evidence id resolves to exactly one image, and each image is referenced by at most one evidence slot across all findings. project.branding.testerLogo.imageId and clientLogo.imageId, when non-null, each resolve to one image that is NOT referenced as evidence. The two logo roles may name the same image. Every image is referenced by evidence or by at least one logo role, otherwise the import is refused; (7) schemaVersion > 2 is refused as 'newer', schemaVersion 1 is validated against the frozen v1 schema and then migrated (see work/claude/26-schema-v2-notes.md), and the migrated result must pass this schema. Exception, in memory only: a migrated v1 that fails ONLY the 25 MiB budget may be held in a recovery state (banner with measured overage, every mutation non-growth, Save and Export refused, exact original v1 bytes downloadable). That exception never applies to a normal v2 import, save or export: a v2 file over budget is refused; (8) evidence references across all findings <= 30, so distinct images <= 32; (9) counters unchanged; (10) XML 1.0 text rule unchanged, applied to every string including labels, engagement rows and the prefix; (11) project.sections.report contains each report key exactly once, and project.sections.finding contains each finding key exactly once; (12) project.engagement.rows has at most one row per bound source other than 'custom'; (13) finding.cvss, when non-null, is a canonical CVSS 3.1 Base vector: prefix CVSS:3.1/, then exactly AV,AC,PR,UI,S,C,I,A once each, in that order, with valid values only. Temporal or Environmental metrics are refused. The score is never stored; it is derived by src/scoring; (14) the visible finding ID is derived as <prefix>-<1-based position>. A valid prefix is a string that, after trimming leading and trailing whitespace, has 1-40 characters, contains no CR, LF or tab, and is XML 1.0 valid. prefix = trimmed findingPrefix if valid, else trimmed engagementId if valid, else 'F'. An engagementId that is invalid as a prefix (for example longer than 40 characters) falls back to 'F' and is never truncated. The visible ID is never stored. Bookmarks use the stable F-NNN id; (15) back-to-summary links are exported only when backToSummaryLinks is true AND sections.report[key=findingsSummary].enabled is true, so no anchor ever dangles. Every internal hyperlink anchor resolves to exactly one bookmark.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schemaVersion",
    "createdAt",
    "savedAt",
    "project",
    "findings",
    "images"
  ],
  "properties": {
    "format": {
      "const": "fieldnote-project"
    },
    "schemaVersion": {
      "const": 2
    },
    "appVersion": {
      "type": "string",
      "maxLength": 32
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "savedAt": {
      "type": "string",
      "format": "date-time"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "paperSize",
        "nextFindingNumber",
        "nextImageNumber",
        "engagementId",
        "findingPrefix",
        "cover",
        "branding",
        "scoring",
        "engagement",
        "sections",
        "labels",
        "backToSummaryLinks"
      ],
      "properties": {
        "title": {
          "$ref": "#/$defs/line"
        },
        "subtitle": {
          "$ref": "#/$defs/line"
        },
        "client": {
          "$ref": "#/$defs/line"
        },
        "testerName": {
          "$ref": "#/$defs/line"
        },
        "organisation": {
          "$ref": "#/$defs/line"
        },
        "reportVersion": {
          "type": "string",
          "maxLength": 32
        },
        "classification": {
          "$ref": "#/$defs/line",
          "$comment": "Free text, may be empty. Replaces nothing hardcoded: the footer shows it only when non-empty."
        },
        "startDate": {
          "$ref": "#/$defs/dateOrEmpty"
        },
        "endDate": {
          "$ref": "#/$defs/dateOrEmpty"
        },
        "reportDate": {
          "$ref": "#/$defs/dateOrEmpty"
        },
        "scope": {
          "$ref": "#/$defs/text"
        },
        "executiveSummary": {
          "$ref": "#/$defs/text"
        },
        "paperSize": {
          "enum": [
            "A4",
            "Letter"
          ]
        },
        "accentColor": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "nextFindingNumber": {
          "type": "integer",
          "minimum": 1,
          "maximum": 999
        },
        "nextImageNumber": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9999
        },
        "engagementId": {
          "$ref": "#/$defs/line",
          "$comment": "The one authority for the engagement ID. Shown in the engagement table through a bound row, and used as the default finding prefix."
        },
        "findingPrefix": {
          "type": "string",
          "maxLength": 40,
          "pattern": "^[^\\r\\n\\t]*$",
          "$comment": "Override for the visible finding-ID prefix. Empty or whitespace-only means: use engagementId if it is non-empty and at most 40 characters after trimming, else 'F'. Separator '-' and no zero padding in 1b."
        },
        "cover": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "branding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "testerLogo",
            "clientLogo"
          ],
          "properties": {
            "testerLogo": {
              "$ref": "#/$defs/logoRole"
            },
            "clientLogo": {
              "$ref": "#/$defs/logoRole"
            }
          }
        },
        "scoring": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "enum": [
                "severity",
                "risk",
                "cvss",
                "severity+cvss",
                "risk+cvss"
              ],
              "$comment": "'severity' and 'risk' use the same stored finding.rating and differ only in the label (labels.severity / labels.risk). Risk is a user-assigned rating, not a computed business risk. Hidden values stay stored."
            }
          }
        },
        "engagement": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rows"
          ],
          "$comment": "Whether the table is exported is controlled only by sections.report[key=engagement].enabled. Row identity is array position; labels need not be unique.",
          "properties": {
            "rows": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "$ref": "#/$defs/engagementRow"
              }
            }
          }
        },
        "sections": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "report",
            "finding"
          ],
          "properties": {
            "report": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "$ref": "#/$defs/sectionConfig",
                "properties": {
                  "key": {
                    "enum": [
                      "executiveSummary",
                      "engagement",
                      "scope",
                      "findingsSummary"
                    ]
                  }
                }
              }
            },
            "finding": {
              "type": "array",
              "minItems": 7,
              "maxItems": 7,
              "items": {
                "$ref": "#/$defs/sectionConfig",
                "properties": {
                  "key": {
                    "enum": [
                      "assets",
                      "description",
                      "details",
                      "impact",
                      "threat",
                      "recommendation",
                      "evidence"
                    ]
                  }
                }
              }
            }
          }
        },
        "labels": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "findings",
            "idColumn",
            "titleColumn",
            "severity",
            "risk",
            "cvss",
            "unscored",
            "figure",
            "part",
            "partOf",
            "page",
            "pageOf",
            "backToSummary",
            "client",
            "version",
            "date"
          ],
          "$comment": "Visible words outside section headings. Each is a short single line and may not be empty. The Word SEQ field identifier stays the fixed internal name 'Figure'; only the visible word changes.",
          "properties": {
            "findings": {
              "$ref": "#/$defs/label"
            },
            "idColumn": {
              "$ref": "#/$defs/label"
            },
            "titleColumn": {
              "$ref": "#/$defs/label"
            },
            "severity": {
              "$ref": "#/$defs/label"
            },
            "risk": {
              "$ref": "#/$defs/label"
            },
            "cvss": {
              "$ref": "#/$defs/label"
            },
            "unscored": {
              "$ref": "#/$defs/label"
            },
            "figure": {
              "$ref": "#/$defs/label"
            },
            "part": {
              "$ref": "#/$defs/label"
            },
            "partOf": {
              "$ref": "#/$defs/label"
            },
            "page": {
              "$ref": "#/$defs/label"
            },
            "pageOf": {
              "$ref": "#/$defs/label"
            },
            "backToSummary": {
              "$ref": "#/$defs/label"
            },
            "client": {
              "$ref": "#/$defs/label"
            },
            "version": {
              "$ref": "#/$defs/label"
            },
            "date": {
              "$ref": "#/$defs/label"
            }
          }
        },
        "backToSummaryLinks": {
          "type": "boolean"
        }
      }
    },
    "findings": {
      "type": "array",
      "maxItems": 20,
      "$comment": "Array order is report order. The visible ID is derived from position (rule 14).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "rating",
          "cvss",
          "formats",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^F-(?!000)[0-9]{3}$"
          },
          "title": {
            "$ref": "#/$defs/line"
          },
          "rating": {
            "enum": [
              "Critical",
              "High",
              "Medium",
              "Low",
              "Informational",
              null
            ],
            "$comment": "v1 'severity', renamed. null = unscored."
          },
          "cvss": {
            "oneOf": [
              {
                "type": "string",
                "maxLength": 64,
                "pattern": "^CVSS:3\\.1/AV:[NALP]/AC:[LH]/PR:[NLH]/UI:[NR]/S:[UC]/C:[NLH]/I:[NLH]/A:[NLH]$"
              },
              {
                "type": "null"
              }
            ]
          },
          "affectedAssets": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "$ref": "#/$defs/line"
            }
          },
          "description": {
            "$ref": "#/$defs/text"
          },
          "details": {
            "$ref": "#/$defs/text",
            "$comment": "v1 'reproduction', migrated with formats.details = 'code'."
          },
          "impact": {
            "$ref": "#/$defs/text"
          },
          "threat": {
            "$ref": "#/$defs/text"
          },
          "recommendation": {
            "$ref": "#/$defs/text"
          },
          "formats": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "description",
              "details",
              "impact",
              "threat",
              "recommendation"
            ],
            "$comment": "plain = blank line is a paragraph, '- ' is a bullet. code = verbatim monospace, every character, tab and leading space kept, no bullet parsing.",
            "properties": {
              "description": {
                "$ref": "#/$defs/textFormat"
              },
              "details": {
                "$ref": "#/$defs/textFormat"
              },
              "impact": {
                "$ref": "#/$defs/textFormat"
              },
              "threat": {
                "$ref": "#/$defs/textFormat"
              },
              "recommendation": {
                "$ref": "#/$defs/textFormat"
              }
            }
          },
          "evidence": {
            "type": "array",
            "maxItems": 30,
            "items": {
              "$ref": "#/$defs/imageId"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "images": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "mime",
          "dataUrl",
          "width",
          "height",
          "bytes",
          "sha256",
          "caption",
          "tallMode"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/imageId"
          },
          "mime": {
            "enum": [
              "image/png",
              "image/jpeg"
            ]
          },
          "dataUrl": {
            "type": "string",
            "pattern": "^data:image/(png|jpeg);base64,[A-Za-z0-9+/]+={0,2}$",
            "maxLength": 2796300
          },
          "width": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16000
          },
          "height": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16000
          },
          "bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2097152
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "caption": {
            "$ref": "#/$defs/line"
          },
          "tallMode": {
            "enum": [
              "auto",
              "fit",
              "split"
            ],
            "$comment": "auto (new default) resolves to split when the image is taller than the usable page height at content width, else fit. Migrated v1 values stay fit/split. Ignored for logo-only images."
          },
          "originalName": {
            "type": "string",
            "maxLength": 255
          }
        }
      }
    }
  },
  "$defs": {
    "line": {
      "type": "string",
      "maxLength": 300,
      "pattern": "^[^\\r\\n]*$"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[^\\r\\n]*\\S[^\\r\\n]*$"
    },
    "text": {
      "type": "string",
      "maxLength": 20000
    },
    "textFormat": {
      "enum": [
        "plain",
        "code"
      ]
    },
    "dateOrEmpty": {
      "type": "string",
      "pattern": "^$|^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "imageId": {
      "type": "string",
      "pattern": "^IMG-(?!0000)[0-9]{4}$"
    },
    "logoRole": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "imageId",
        "front",
        "header",
        "footer"
      ],
      "$comment": "front = the cover page when cover.enabled, else the title block. Logos are always scaled into a bounded box.",
      "properties": {
        "imageId": {
          "oneOf": [
            {
              "$ref": "#/$defs/imageId"
            },
            {
              "type": "null"
            }
          ]
        },
        "front": {
          "type": "boolean"
        },
        "header": {
          "type": "boolean"
        },
        "footer": {
          "type": "boolean"
        }
      }
    },
    "sectionConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "label",
        "enabled"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "label": {
          "$ref": "#/$defs/label"
        },
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "engagementRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "label",
        "enabled"
      ],
      "$comment": "Bound rows display an existing project value and have no own value: engagementId, client, testerName, organisation, testingPeriod (startDate to endDate), reportVersion, reportDate, classification. 'custom' rows carry value and format. Exported only when enabled and the displayed value is non-empty.",
      "properties": {
        "source": {
          "enum": [
            "custom",
            "engagementId",
            "client",
            "testerName",
            "organisation",
            "testingPeriod",
            "reportVersion",
            "reportDate",
            "classification"
          ]
        },
        "label": {
          "$ref": "#/$defs/label"
        },
        "enabled": {
          "type": "boolean"
        },
        "value": {
          "$ref": "#/$defs/text"
        },
        "format": {
          "$ref": "#/$defs/textFormat"
        }
      },
      "if": {
        "properties": {
          "source": {
            "const": "custom"
          }
        }
      },
      "then": {
        "required": [
          "value",
          "format"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "value"
              ]
            },
            {
              "required": [
                "format"
              ]
            }
          ]
        }
      }
    }
  }
}
